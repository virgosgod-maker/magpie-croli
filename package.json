{
  "name": "magpie-croli",
  "version": "0.1.10",
  "description": "Expose the verified Croli gateway models through magpie with native API-key passthrough and no official-client prompt injection.",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "README.md",
    "README-TEMPLATE.md",
    "AGENTS.md",
    "CHECKLIST.md",
    "HOOKS.md",
    "UPDATING.md",
    "CHANGELOG.md",
    "MULTI-PROVIDER.md",
    "NOTICE.md",
    "LICENSE",
    "extract-contract.py",
    "registry-entry.json",
    "tests",
    "scripts",
    "examples",
    "ERROR-CODES.md",
    "RECYCLING.md",
    "GUIDE.md",
    "OFFICIAL-SOURCES.md",
    "SCORING.md",
    "CONTRIBUTING.md",
    "docs"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "opencode-auth",
    "provider",
    "croli",
    "deepseek",
    "openai",
    "anthropic",
    "xai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MYCF711/magpie-croli.git"
  },
  "homepage": "https://github.com/MYCF711/magpie-croli",
  "bugs": {
    "url": "https://github.com/MYCF711/magpie-croli/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/png;base64,",
    "maxConcurrency": 4,
    "name": "Croli 免费模型 Croli Free Models"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:errors": "node scripts/check-error-codes.mjs .",
    "check:ua": "node scripts/check-ua.mjs .",
    "create": "node scripts/create.mjs",
    "release": "node scripts/release.mjs",
    "score": "node scripts/score.mjs",
    "maintenance": "node scripts/check-maintenance.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:host": "node scripts/verify-host.mjs",
    "verify:account": "node scripts/verify-account.mjs"
  }
}
